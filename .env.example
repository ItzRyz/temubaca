# Copy to .env.local and replace every placeholder with values from your own services.
# Never commit .env.local or real credentials.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# PostgreSQL runtime connection. For Supabase serverless use a supported transaction pooler
# with node-postgres; verify your host's connection limits before choosing pool size.
# Do not put sslmode/sslcert/sslkey/sslrootcert query options in DATABASE_URL in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional PEM-encoded custom root CA; it is added to Node's default trust store.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Direct/session connection used by Drizzle migrations; defaults to DATABASE_URL if omitted.
# DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE
# Connections per server instance (default 10). On Vercel with the transaction pooler use a small value, e.g. 3.
# DATABASE_POOL_MAX=10

# Required by API endpoints that enforce rate limits
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional integrations; leave unset until selected and configured.
# SUPABASE_SERVICE_ROLE_KEY=
# GOOGLE_BOOKS_API_KEY=
# RECOMMENDATION_API_URL=
# RECOMMENDATION_API_KEY=
# INTERNAL_API_SECRET=
# Vercel Cron secret (min. 32 characters) for the daily retention job in vercel.json.
# CRON_SECRET=
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

#test commit